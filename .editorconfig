root = true

# Repository EditorConfig — Markdown-only project.
# Defaults for every file. Markdown keeps trailing spaces: two spaces
# are a hard line break. Other files drop trailing whitespace.
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
max_line_length = 80
trim_trailing_whitespace = false

# Preserve tabs in Makefiles if any exist
[Makefile]
indent_style = tab
trim_trailing_whitespace = false
